        "sendTo": "={{ $(\"Normalize Lead\").first().json.email }}",
        "subject": "=Thanks for contacting Lumora Digital, {{ $(\"Normalize Lead\").first().json.firstName }}",
        "message": "=<div style=\"font-family:Arial,Helvetica,sans-serif;max-width:560px;margin:0 auto;color:#141a33;line-height:1.6\"><h2 style=\"color:#5b4bd6;margin-bottom:8px\">Hi {{ $(\"Normalize Lead\").first().json.firstName }},</h2><p>Thank you for getting in touch with <b>Lumora Digital</b>. We have received your enquiry for <b>{{ $(\"Normalize Lead\").first().json.company }}</b>.</p><p>We are a growth agency that designs fast websites, grows search traffic and automates the follow-ups that turn enquiries into customers. Our services include website design and development, SEO and content, social media marketing, email and marketing automation, and brand identity.</p><p>You told us you are interested in <b>{{ $(\"Normalize Lead\").first().json.service }}</b>. In practice that means {{ $(\"Normalize Lead\").first().json.serviceBlurb }}.</p><p><b>What happens next?</b><br>A member of our team will review your message and reply personally within one business day with a tailored proposal.</p><p style=\"margin-top:24px\">Warm regards,<br><b>The Lumora Digital Team</b></p><hr style=\"border:none;border-top:1px solid #e1e6f0;margin:24px 0\"><p style=\"font-size:12px;color:#566080\">You are receiving this because you submitted the contact form on our website.</p></div>",
        "options": {
          "appendAttribution": false,
          "senderName": "Lumora Digital"
        }
